          ]
        },
        "entity": {
          "description": "Only items that involve this narrative entity id.",
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9:_.\\-/[\\]]+$"
        },
        "limit": {
          "default": 20,
          "description": "Items per page.",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "cursor": {
          "description": "Opaque cursor from next_cursor of the previous page.",
          "type": "string",
          "pattern": "^o:\\d{1,5}$"
        }
      },
      "additionalProperties": false
    },
    "evaluate_decision_tree": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "tree_id": {
          "description": "Omit to list the available trees.",
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9:_.\\-/[\\]]+$"
        },
        "choices": {
          "description": "Creator selections: decision node id to chosen branch id. Without them the walk stops at the first open choice.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9:_.\\-/[\\]]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9:_.\\-/[\\]]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "build_research_context": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The research question or topic."
        },
        "focus_entities": {
          "description": "Entity ids to include whatever the ranking says.",
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9:_.\\-/[\\]]+$"
          }
        },
        "include": {
          "description": "Sections to include. Default: all.",
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "statistics",
              "narrative",
              "relationships",
              "consistency_findings",
              "creative_opportunities",
              "decision_trees",
              "drift"
            ]
          }
        },
        "source_policy": {
          "default": "production_only",
          "description": "Whether remodeling proposals may appear. They stay labeled PROPOSED.",
          "type": "string",
          "enum": [
            "production_only",
            "include_proposed"
          ]
        },
        "max_evidence_items": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "detail": {
          "default": "compact",
          "type": "string",
          "enum": [
            "compact",
            "standard"
          ]
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  }
}
