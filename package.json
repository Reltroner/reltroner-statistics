{
  "name": "reltroner-statistics",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Civilizational Data Intelligence Observatory: production-first statistics and read-only cross-repository drift intelligence for Reltroner Studio",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:py": "node scripts/run-python.mjs -m pytest analytics/python/tests -q --rootdir analytics/python -p no:cacheprovider",
    "test:e2e": "playwright test",
    "typecheck": "astro check",
    "pipeline": "node scripts/pipeline.ts",
    "verify:baseline": "node scripts/verify-baseline.ts",
    "schemas": "node scripts/generate-schemas.ts",
    "schemas:check": "node scripts/generate-schemas.ts --check",
    "dev": "astro dev",
    "build:site": "node scripts/require-artifacts.ts && astro build",
    "build:pdf": "node scripts/render-pdf.ts",
    "build": "node scripts/build.ts",
    "preview": "node scripts/serve.ts",
    "verify": "npm test && npm run schemas:check && npm run typecheck && npm run build && npm run test:e2e",
    "build:post": "node scripts/postbuild.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.26",
    "@xyflow/react": "12.12.1",
    "astro": "7.4.1",
    "echarts": "6.1.0",
    "elkjs": "0.12.1",
    "fflate": "0.8.3",
    "motion": "14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pdfjs-dist": "6.5.438",
    "typescript": "6.0.3"
  }
}
