            "required": [
              "id",
              "name",
              "cohort",
              "population_billion",
              "land_area_million_km2",
              "production_land_area_million_km2",
              "production_population_billion",
              "spatial_status_label",
              "land_area_status_label",
              "reference",
              "surface_status",
              "surface_denominator",
              "surface",
              "habitat_status",
              "habitat_denominator",
              "habitats",
              "geometry",
              "pointer"
