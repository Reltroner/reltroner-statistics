{
  "$id": "https://reltroner-statistics.invalid/schemas/composition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "reltroner-composition.v2"
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "properties": {
        "production": {
          "type": "object",
          "properties": {
            "side": {
              "type": "string",
              "const": "production"
            },
            "repository": {
              "type": "string",
              "const": "Reltroner/reltroner-studio"
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "blob_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "side",
            "repository",
            "commit_sha",
            "blob_sha",
            "path"
          ],
          "additionalProperties": false
        },
        "remodeling": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "side": {
                  "type": "string",
                  "const": "remodeling"
                },
                "repository": {
                  "type": "string",
                  "const": "Reltroner/reltroner-studio-remodeling"
                },
                "commit_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "blob_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "side",
                "repository",
                "commit_sha",
                "blob_sha",
                "path"
