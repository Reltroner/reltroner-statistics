      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "production",
              "remodeling"
            ]
          },
          "repository": {
            "type": "string"
          },
          "commit_sha": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
