    "canonical_path",
    "title",
    "html_title",
    "description",
    "lang",
    "site_section",
    "family",
    "content_kind",
    "static_or_dynamic",
    "route_pattern",
    "source_role",
    "declared_sources",
    "snapshot",
    "links",
    "coverage",
    "interactive",
    "sections",
    "data",
    "datasets",
    "known_unknowns",
    "limitations",
