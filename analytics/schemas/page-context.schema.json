                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "component"
                    },
                    "component": {
                      "type": "string"
                    },
                    "hydration": {
                      "type": "string"
                    },
                    "server_rendered": {
                      "type": "boolean"
                    },
                    "data_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "type",
                    "component",
                    "hydration",
                    "server_rendered",
                    "data_ids"
                  ],
                  "additionalProperties": false
                }
              ]
            }
