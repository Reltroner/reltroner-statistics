      "type": "string",
      "const": "rs-page-context.v1"
    },
    "page_id": {
      "type": "string"
    },
    "canonical_url": {
      "type": "string"
    },
    "canonical_path": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "html_title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "lang": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_section": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "content_kind": {
      "type": "string",
      "enum": [
        "document",
        "interactive",
        "dynamic_record",
        "report_export"
      ]
    },
    "static_or_dynamic": {
      "type": "string",
      "enum": [
        "static",
        "dynamic"
      ]
    },
    "route_pattern": {
      "type": "string"
