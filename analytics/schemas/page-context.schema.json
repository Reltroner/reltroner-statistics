                "commit_sha": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
