---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import StatTile from '../../components/StatTile.astro';
import CompositionExplorer from '../../features/statistics/CompositionExplorer.tsx';
import { getComposition } from '../../lib/data.ts';

const data = getComposition();
const surface = data.countries.filter((c) => c.surface_status === 'ASSIGNED').length;
const habitats = data.countries.filter((c) => c.habitat_status === 'ASSIGNED').length;
---
<BaseLayout title="Spatial 3D composition" description="Remodeling creator-ratified NCCM V6.5 national land-footprint and unique-resident habitat composition with distinct denominators and missing 3D geometry explicitly identified.">
  <PageIntro eyebrow="Domain · Spatial 3D · NCCM V6.5 · Remodeling Canon C"
    title="Spatial 3D composition · Year 0"
    lede="Measure where terrestrial land is classified and where sentient residents principally live. Compare footprints and habitats across nations without confusing two-dimensional land, unique residents, urbanization or unknown volumetric geometry."
    crumbs={[{ href: '/statistics', label: 'Statistics' }, { label: 'Spatial 3D' }]}
    sources={['production','remodeling','model','statistics']} model={data.model_version}
    limits={[
      'The screenshot measurements live in the pinned Remodeling model, NOT the current Studio production JSON. Publication status remains explicitly separate.',
      'Terrestrial surface footprint is percentage of national land area—not built, constructed or habitable km³.',
      'Principal home habitat is percentage of unique residents—not surface area, density or the urbanization rate.',
      'National polygons, constructed volume, habitable volume, underwater residence by depth and marine carrying capacity remain UNASSIGNED (not zero).',
      'Eighteen deferred states are a combined population aggregate without inventing individual country geometry.',
    ]}
  />
  <section class="pb-9" aria-label="Spatial composition coverage">
    <div class="rs-container grid grid-cols-2 gap-3 lg:grid-cols-4">
      <StatTile label="Nations in current analysis" value={String(data.countries.length)} note="14 original + 5 development" />
      <StatTile label="Footprint distributions" value={String(surface)} note="Four land classes per assigned nation" />
      <StatTile label="Principal habitat distributions" value={String(habitats)} note="Four resident classes per assigned nation" />
      <StatTile label="Constructed km³ / national polygons" value="Unassigned" note="No invented 3D mesh or volume" />
    </div>
  </section>
  <section class="pb-12">
    <div class="rs-container">
      <CompositionExplorer client:load mode="spatial" data={data} />
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/statistics/species" class="rs-button rs-button-ghost no-underline">Explore Species & Ancestry →</a>
        <a href="/statistics" class="rs-button rs-button-ghost no-underline">Return to Statistical Dashboard →</a>
      </div>
    </div>
  </section>
</BaseLayout>
