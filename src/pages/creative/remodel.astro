---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import CreativeSubnav from '../../components/CreativeSubnav.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import CanonRemodelLab from '../../features/creative/CanonRemodelLab.tsx';
import { getCreative, getGraph } from '../../lib/data.ts';

const creative = getCreative();
const graph = getGraph();
---
<BaseLayout
  title="Canon remodeling laboratory"
  description="Isolated scenario exploration comparing verified production canon, remodeling candidates and hypothetical parameters across 8 impact dimensions."
>
  <CreativeSubnav />
  <PageIntro
    eyebrow="Surface 4 · Canon Remodeling & Consequence Laboratory"
    title="Canon remodeling & scenario sandbox"
    lede="Compare verified production canon against remodeling candidates and interactive scenario parameters inside an isolated sandbox. Production values are never overwritten, and mathematical impacts are strictly separated from qualitative narrative hypotheses."
    crumbs={[{ label: 'Creative', href: '/creative' }, { label: 'Remodel' }]}
    sources={['production', 'remodeling', 'rules']}
    limits={[
      'All remodeling scenarios remain SCENARIO or PROPOSED until ratified in Reltroner/reltroner-studio.',
      'Psychological and social consequences without a validated formula are explicitly marked INSUFFICIENT_DATA_NO_QUANTITATIVE_MODEL.',
    ]}
  >
    <ImageSlot slotId="CREATIVE_CANON_REMODEL" slot="aside" />
  </PageIntro>

  <section class="pb-12">
    <div class="rs-container">
      <CanonRemodelLab
        client:load
        scenarios={creative.scenarios}
        entities={creative.entities}
        relationships={creative.relationships}
        graph={graph}
        defaultMode="remodel"
      />
    </div>
  </section>
</BaseLayout>

