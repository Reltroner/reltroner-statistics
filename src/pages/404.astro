---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ROUTES } from '../lib/site.ts';
---
<BaseLayout title="Not found" description="This page does not exist in the Reltroner Statistics observatory." noindex>
  <section class="py-20">
    <div class="rs-container max-w-3xl">
      <p class="rs-eyebrow">404 · No observation here</p>
      <h1 class="mt-3 text-[clamp(2rem,4vw,3rem)] font-[760]">This page is not part of the observatory.</h1>
      <p class="rs-lede mt-4">The address may be from an older release, or a finding ID that no longer exists at the current pinned commits. Search with <kbd class="rs-kbd">Ctrl K</kbd>, or start from one of these pages.</p>
      <ul class="mt-8 grid gap-2 sm:grid-cols-2">
        {ROUTES.map((r) => <li><a href={r.path} class="rs-card rs-card-link block p-3"><span class="font-semibold text-ink">{r.title}</span><span class="block text-xs text-ink-3">{r.summary}</span></a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
