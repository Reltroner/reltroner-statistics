---
import { ECOSYSTEM, SECTIONS, SECTION_PAGES, sectionFor } from '../lib/site.ts';
const pathname = Astro.url.pathname;
const active = sectionFor(pathname);
---
<header data-site-header class="sticky top-0 z-40 border-b border-line backdrop-blur-xl" style="background: color-mix(in srgb, var(--bg) 82%, transparent);">
  <div class="rs-container rs-header-shell flex min-h-16 items-center gap-2 py-1 xl:gap-4">
    <a href="/" aria-label="Reltroner Statistics home" class="flex shrink-0 items-center gap-2.5 text-ink no-underline xl:gap-3">
      <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="12.5" fill="none" stroke="var(--accent)" stroke-width="1.6" opacity="0.9" />
        <ellipse cx="16" cy="16" rx="12.5" ry="5" fill="none" stroke="var(--cyan)" stroke-width="1.2" opacity="0.75" transform="rotate(-24 16 16)" />
        <circle cx="16" cy="16" r="3.2" fill="var(--accent)" />
        <circle cx="26.2" cy="11.4" r="1.9" fill="var(--cyan)" />
      </svg>
      <span data-header-brand-label class="leading-none">
        <span class="block text-[0.82rem] font-extrabold tracking-[0.16em]">RELTRONER</span>{" "}
        <span class="block text-[0.66rem] font-semibold tracking-[0.26em] text-cyan">STATISTICS</span>
      </span>
    </a>

    <nav aria-label="Primary" data-primary-nav class="rs-header-primary ml-1 min-w-0 xl:ml-3">
      <ul class="flex items-center gap-0.5 xl:gap-1">
        {SECTIONS.map((s) => (
          <li>
            <a href={s.href} aria-current={active === s.id ? 'page' : undefined}
              class:list={[' whitespace-nowrap rounded-lg px-2 py-1.5 text-[0.8125rem] font-semibold no-underline transition-colors xl:px-3 xl:py-2 xl:text-sm',
                active === s.id ? 'bg-accent-soft text-ink' : 'text-ink-2 hover:bg-accent-soft hover:text-ink']}>
              {s.label}
            </a>
          </li>
        ))}
        <li>
          <a href="https://www.reltroner.com/contact" target="_blank" rel="noopener noreferrer" data-studio-contact-link
            class="whitespace-nowrap rounded-lg px-2 py-1.5 text-[0.8125rem] font-semibold text-ink-2 no-underline transition-colors hover:bg-accent-soft hover:text-ink xl:px-3 xl:py-2 xl:text-sm">
            Contact<span class="rs-sr"> (opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1.5">
      <button type="button" data-palette-open class="rs-header-search-full rs-button rs-button-ghost !min-h-10 gap-3 border border-line px-3" aria-keyshortcuts="Control+K">
        <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="text-sm">Search</span>
        <kbd class="rs-kbd">Ctrl K</kbd>
      </button>
      <button type="button" data-palette-open class="rs-header-search-compact rs-button rs-button-ghost !min-h-10 !px-2.5" aria-label="Search the observatory">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </button>

      <div class="rs-header-ecosystem relative">
        <button type="button" data-ecosystem-toggle aria-expanded="false" aria-controls="ecosystem-menu" class="rs-button rs-button-ghost !min-h-10 !px-3 text-sm">
          Ecosystem
          <svg class="rs-chevron" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6" /></svg>
        </button>
        <div id="ecosystem-menu" hidden data-ecosystem-menu role="group" aria-labelledby="ecosystem-menu-h"
          class="rs-card absolute right-0 top-[calc(100%+0.6rem)] z-50 w-[22rem] max-w-[calc(100vw-1.5rem)] p-2" style="box-shadow: var(--shadow-pop);">
          <p id="ecosystem-menu-h" class="rs-eyebrow px-3 pb-1 pt-2">Platform Ecosystem</p>
          <ul class="grid gap-1">
            {ECOSYSTEM.map((e) => (
              <li>
                {e.current ? (
                  <div aria-current="true" data-ecosystem-current class="rs-eco-row rs-eco-current">
                    <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                      <span class="text-sm font-semibold text-ink">{e.label}</span>
                      <span class="rs-eco-here">You are here</span>
                    </span>
                    <span class="mt-0.5 block text-xs leading-5 text-ink-2">{e.description}</span>
                  </div>
                ) : (
                  <a href={e.href} target="_blank" rel="noopener noreferrer" class="rs-eco-row block no-underline">
                    <span class="flex items-center gap-1 text-sm font-semibold text-ink">{e.label}<span aria-hidden="true">↗</span><span class="rs-sr"> (opens in a new tab)</span></span>
                    <span class="mt-0.5 block text-xs leading-5 text-ink-3">{e.description}</span>
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <button type="button" data-theme-toggle class="rs-button rs-button-ghost !min-h-10 !px-2.5" aria-label="Switch theme">
        <svg class="theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg class="theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>

      <button type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-nav" class="rs-header-menu-toggle rs-button rs-button-ghost !min-h-10 !px-2.5" aria-label="Open navigation menu">
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" hidden aria-label="Mobile" class="border-t border-line" style="background: var(--bg); max-height: calc(100dvh - 4rem); overflow-y: auto;">
    <div class="rs-container grid gap-5 py-5 sm:grid-cols-2">
      <div>
        <a href="/" class="text-sm font-semibold" aria-current={pathname === '/' ? 'page' : undefined}>Observatory overview</a>
      </div>
      <div>
        <a href="https://www.reltroner.com/contact" target="_blank" rel="noopener noreferrer" data-studio-contact-link
          class="block rounded-lg py-1 text-[0.95rem] font-semibold text-ink-2 no-underline hover:text-ink">
          Contact <span aria-hidden="true">↗</span><span class="rs-sr"> (opens in a new tab)</span>
        </a>
      </div>
      {SECTIONS.map((s) => (
        <div>
          <p class="rs-eyebrow mb-2">{s.label}</p>
          <ul class="grid gap-1">
            {(SECTION_PAGES[s.id].length ? SECTION_PAGES[s.id] : [{ href: s.href, label: s.label }]).map((p) => (
              <li><a href={p.href} class="block rounded-lg px-2 py-2 text-[0.95rem] text-ink-2 no-underline hover:bg-accent-soft hover:text-ink" aria-current={pathname.replace(/\/+$/, '') === p.href ? 'page' : undefined}>{p.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <p class="rs-eyebrow mb-2" id="mobile-ecosystem-h">Platform Ecosystem</p>
        <ul class="grid gap-1" aria-labelledby="mobile-ecosystem-h">
          {ECOSYSTEM.map((e) => (
            <li>
              {e.current ? (
                <div aria-current="true" data-ecosystem-current class="rs-eco-row rs-eco-current !px-2 !py-2">
                  <span class="flex flex-wrap items-center gap-x-2 gap-y-1"><span class="text-[0.95rem] font-semibold text-ink">{e.label}</span><span class="rs-eco-here">You are here</span></span>
                </div>
              ) : (
                <a href={e.href} target="_blank" rel="noopener noreferrer" class="block rounded-lg px-2 py-2 text-[0.95rem] text-ink-2 no-underline hover:bg-accent-soft">{e.label} <span aria-hidden="true">↗</span><span class="rs-sr"> (opens in a new tab)</span></a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </nav>
</header>

<style>
  /* RS-UI-RESPONSIVE-007: query the *capped content width*, not the viewport. CSS em query
     thresholds follow the header font size, so enlarged text keeps navigation accessible
     through the compact menu instead of forcing desktop links outside the viewport. */
  .rs-header-shell { container-type: inline-size; }
  .rs-header-primary, .rs-header-search-full, .rs-header-ecosystem { display: none; }
  .rs-header-search-compact, .rs-header-menu-toggle { display: inline-flex; }
  @container (min-width: 77em) {
    .rs-header-primary, .rs-header-ecosystem { display: block; }
    .rs-header-search-full { display: inline-flex; }
    .rs-header-search-compact, .rs-header-menu-toggle { display: none; }
  }
  @container (max-width: 21em) {
    [data-header-brand-label] { display: none; }
  }
  .rs-eco-row { display: block; border-radius: 0.85rem; padding: 0.75rem; }
  a.rs-eco-row:hover { background: var(--surface-2); }
  a.rs-eco-row:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .rs-eco-current { background: var(--accent-soft); box-shadow: inset 3px 0 0 var(--accent); }
  .rs-eco-here { display: inline-flex; align-items: center; border-radius: 999px; padding: 0.05rem 0.55rem; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em; color: var(--accent-contrast); background: var(--accent-strong); white-space: nowrap; }
  [data-ecosystem-toggle][aria-expanded='true'] .rs-chevron { transform: rotate(180deg); }
  .rs-chevron { transition: transform 160ms ease; }
  @media (prefers-reduced-motion: reduce) { .rs-chevron { transition: none; } }
  [data-theme-toggle] .theme-icon-sun { display: none; }
  [data-theme-toggle][data-current='light'] .theme-icon-sun { display: block; }
  [data-theme-toggle][data-current='light'] .theme-icon-moon { display: none; }
  :global(body.overflow-hidden) { overflow: hidden; }
</style>

<script>
  import '../scripts/header.ts';
</script>
