---
interface Props { items: Array<{ href?: string; label: string }> }
const { items } = Astro.props;
const all = [{ href: '/', label: 'Observatory' }, ...items];
---
<nav aria-label="Breadcrumb" class="mb-4">
  <ol class="flex flex-wrap items-center gap-1.5 text-[0.8rem] text-ink-3">
    {all.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {c.href && i < all.length - 1
          ? <a href={c.href} class="text-ink-3 no-underline hover:text-ink hover:underline">{c.label}</a>
          : <span aria-current={i === all.length - 1 ? 'page' : undefined} class="text-ink-2">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>
