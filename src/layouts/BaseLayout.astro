---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import NewsletterPlacement from '../components/NewsletterPlacement.astro';
import { mirrorBase } from '../domain/page-url.ts';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const fullTitle = title === 'Reltroner Statistics' ? title : `${title} · Reltroner Statistics`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
// RS-AI-PAGE-004: machine-readable mirrors of this page, built from the same output (no script, no request).
const mirror = noindex ? null : mirrorBase(Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/?$/, '/'));
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#030a18" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {mirror && <link rel="alternate" type="application/json" href={`${mirror}.json`} title="Page mirror (rs-page-context.v1)" />}
    {mirror && <link rel="alternate" type="text/markdown" href={`${mirror}.md`} title="Page mirror (Markdown)" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48x48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <script is:inline>(function(){try{var t=localStorage.getItem('rs-theme');if(t!=='light'&&t!=='dark'){t=window.matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';}document.documentElement.dataset.theme=t;}catch(e){}})();</script>
  </head>
  <body>
    <a class="rs-skip" href="#main">Skip to content</a>
    <div class="rs-backdrop" aria-hidden="true"></div>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {/* RS-NEWSLETTER-BRANDING-EXPORT-008 R1: one shared Studio newsletter opt-in on every indexable page (not the 404 page). */}
    {!noindex && <NewsletterPlacement />}
    <SiteFooter />
  </body>
</html>
